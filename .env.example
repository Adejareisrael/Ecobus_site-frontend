# Postgres connection string (Supabase: use the "connection pooling" URI, port 6543).
# Supabase's pooler cert chain fails strict verification, so sslmode=no-verify is required.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&sslmode=no-verify"
DIRECT_URL="postgresql://user:password@db.your-project.supabase.co:5432/postgres?sslmode=require"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"

# Firebase (Google sign-in). Client values come from Firebase Console >
# Project settings > General > Your apps > Web app config — these are public,
# safe to expose in the browser. The three FIREBASE_* server values come from
# Project settings > Service accounts > Generate new private key.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Paystack
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PAGE_URL=""

# Resend (ticket emails)
RESEND_API_KEY=""
EMAIL_FROM="Ecobus <tickets@ecobustransport.com>"
SUPPORT_EMAIL="support@ecobustransport.com"

# Public site URL used to build ticket links in emails
NEXT_PUBLIC_SITE_URL="https://booking.ecobustransport.com"

# Supabase Storage (admin-uploaded route card images — service role key, server-side only)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="site-assets"
